{
  "name": "@mxv/ui",
  "version": "0.0.0",
  "description": "Opinionated React component library built on Tailwind v4 and Radix primitives.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwindcss",
    "radix",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mxvsh/ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/mxvsh/ui#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@mxv/tsconfig": "workspace:*",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "tsc-alias": "^1.8.17"
  }
}
